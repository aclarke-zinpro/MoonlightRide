# Copy to .env.local and fill in. Never commit real values.
# Postgres connection string. Leave empty in development to use the built-in PGlite database.
DATABASE_URL=
# Long random string used to sign organizer sessions (e.g. `openssl rand -base64 48`).
AUTH_SECRET=
# Secret used to hash visitor IP addresses for rate limiting.
IP_HASH_SECRET=
# Resend API key (production only; development prints emails to the terminal).
RESEND_API_KEY=
# Sender, e.g. "Moonlight Ride <ride@example.com>"
MAIL_FROM=
# Public base URL of the site, used in email links.
SITE_URL=http://localhost:3000
# Bearer token Vercel Cron uses to call /api/cron/retention.
CRON_SECRET=
# Vercel Blob token for cover-image uploads (production only).
BLOB_READ_WRITE_TOKEN=
